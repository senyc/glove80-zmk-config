#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define HYPER LC(LS(LG(LALT)))

// layers
#define DEFAULT 0
#define NUM 1
#define SYM 2
#define FUNC 3
#define MAGIC 4
#define FACTORY_TEST 5

/ {
    behaviors {
      hml: home_row_mod_left {
             compatible = "zmk,behavior-hold-tap";
             #binding-cells = <2>;
             flavor = "balanced";
             require-prior-idle-ms = <150>;
             tapping-term-ms = <280>;
             quick-tap-ms = <175>;
             bindings = <&kp>, <&kp>;
             hold-trigger-key-positions = <39 40 41 42 43 61 62 63 64 65 66>;
             hold-trigger-on-release;
       };
       hmr: home_row_mod_right {
             compatible = "zmk,behavior-hold-tap";
             #binding-cells = <2>;
             flavor = "balanced";
             require-prior-idle-ms = <150>;
             tapping-term-ms = <280>;
             quick-tap-ms = <175>;
             bindings = <&kp>, <&kp>;
             hold-trigger-key-positions = <34 35 36 37 38 56 57 58 59 60>;
             hold-trigger-on-release;
       };
       magic: magic_hold_tap {
           compatible = "zmk,behavior-hold-tap";
           label = "MAGIC_HOLD_TAP";
           #binding-cells = <2>;
           flavor = "tap-preferred";
           tapping-term-ms = <200>;
           bindings = <&mo>, <&rgb_ug_status_macro>;
       };
    };

    conditional_layers {
          compatible = "zmk,conditional-layers";
          tri_layer {
              if-layers = <1 2>;
              then-layer = <3>;
          };
    };
    macros {
        rgb_ug_status_macro: rgb_ug_status_macro_0 {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&rgb_ug RGB_STATUS>;
        };

        bt_0: bt_profile_macro_0 {
            label = "BT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 0>;
        };

        bt_1: bt_profile_macro_1 {
            label = "BT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 1>;
        };

        bt_2: bt_profile_macro_2 {
            label = "BT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 2>;
        };

        bt_3: bt_profile_macro_3 {
            label = "BT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
              &none          &none    &none        &none        &none                                                                                                           &none          &none       &none        &none      &none
              &none          &none    &none        &none        &none         &none                                                                                     &none   &none          &none       &none        &none      &none
              &none          &kp Q    &kp W        &kp E        &kp R         &kp T                                                                                     &kp Y   &kp U          &kp I       &kp O        &kp P      &none
              &none          &kp A    &hml LGUI S  &hml LALT D  &hml LCTRL F  &kp G                                                                                     &kp H   &hmr RCTRL J   &hmr RALT K &hmr RGUI L  &kp ENTER  &none
              &none          &kp Z    &kp X        &kp C        &kp V         &kp B         &none       &none    &none     &none     &none    &none                     &kp N   &kp M          &kp COMMA   &kp PERIOD   &kp SLASH  &none
              &magic MAGIC 0 &none    &none        &none        &none                       &kp SPACE   &mo NUM  &kp TAB   &kp BSPC  &mo SYM  &mt RSHIFT ESC                    &none          &none       &none        &none      &none
            >;
        };

        num_layer {
            bindings = <
              &none         &none      &none        &none        &none                                                                                                                     &none          &none        &none         &none        &none
              &none         &none      &none        &none        &none          &none                                                                                          &none       &none          &none        &none         &none        &none
              &none         &kp EXCL   &kp DQT      &kp HASH     &kp EQL        &kp STAR                                                                                       &kp PERCENT &kp PLUS       &kp LPAR     &kp RPAR      &kp SQT      &none
              &none         &kp N1     &hml LGUI N2 &hml LALT N3 &hml LCTRL N4  &kp N5                                                                                         &kp N6      &hmr RCTRL N7  &hmr RALT N8 &hmr RGUI N9  &kp N0       &none
              &none         &kp QMARK  &kp PIPE     &kp DOLLAR   &kp UNDER      &kp TILDE   &none       &none       &none             &none      &none          &none          &kp CARET   &kp MINUS      &kp COMMA    &kp PERIOD    &kp SLASH    &none
              &none         &none      &none        &none        &none                      &kp SPACE   &mo NUM     &kp TAB           &kp BSPC   &mo SYM        &mt RSHIFT ESC             &none          &none        &none         &none        &none
            >;
        };
        // need at sign
        sym_layer {
            bindings = <
              &none         &none      &none           &none            &none                                                                                                                        &none              &none            &none              &none        &none
              &none         &none      &none           &none            &none              &none                                                                                       &none         &none              &none            &none              &none        &none
              &none         &kp EXCL   &kp DQT         &kp AMPS         &kp EQL            &kp AT_SIGN                                                                                 &kp PERCENT   &kp PLUS           &kp LPAR         &kp RPAR           &kp SQT      &none
              &none         &kp LBKT   &hml LGUI RBKT  &hml LALT LBRC   &hml LCTRL RBRC    &kp BSLH                                                                                    &kp LT        &hmr RCTRL COLON   &hmr RALT GT     &hmr RGUI SEMI     &kp ENTER    &none
              &none         &kp QMARK  &kp PIPE        &kp DOLLAR       &kp UNDER          &kp GRAVE     &none       &none    &none        &none       &none        &none              &kp CARET     &kp MINUS          &kp COMMA        &kp PERIOD         &kp SLASH    &none
              &none         &none      &none           &none            &none                            &kp SPACE   &mo NUM  &kp TAB      &kp BSPC    &mo SYM      &mt RSHIFT ESC                   &none              &none            &none              &none        &none
            >;
        };
        func_layer {
            bindings = <
              &none         &none          &none           &none            &none                                                                                                                           &none           &none          &none         &none        &none
              &none         &none          &none           &none            &none             &none                                                                                             &none       &none           &none          &none         &none        &none
              &none         &kp F1         &kp F2          &kp F3           &kp F4            &kp F5                                                                                            &kp F6      &kp F7          &kp F8         &kp F2        &kp F2       &none
              &none         &mt LGUI PG_DN &mt LALT PG_UP  &mt  LCTRL HOME  &mt LSHIFT END    &kp C_PP                                                                                          &kp LEFT    &kp DOWN        &kp UP         &kp RIGHT     &kp PSCRN    &none
              &none         &kp DEL        &kp F11         &kp C_PREV       &kp C_NEXT        &kp F12         &none       &none    &none            &none       &none          &none            &kp C_STOP  &kp C_VOL_DN    &kp C_VOL_UP   &none         &kp C_PWR    &none
              &none         &none          &none           &none            &none                             &kp SPACE   &mo NUM  &kp TAB          &kp BSPC    &mo SYM        &mt RSHIFT ESC               &none           &none          &none         &none        &none
            >;
        };

        magic_layer {
            bindings = <
            &bt BT_CLR        &none               &none           &none           &none                                                                                                           &none      &none      &none      &none      &bt BT_CLR_ALL
            &none             &none               &none           &none           &none           &none                                                                                &none      &none      &none      &none      &none      &none
            &none             &rgb_ug RGB_SPI     &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_BRI &rgb_ug RGB_TOG                                                                      &none      &none      &none      &none      &none      &none
            &bootloader       &rgb_ug RGB_SPD     &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_BRD &rgb_ug RGB_EFF                                                                      &none      &none      &none      &none      &none      &bootloader
            &sys_reset        &none               &none           &none           &none           &none           &bt_2     &bt_3     &none            &none     &none     &none       &none      &none      &none      &none      &none      &sys_reset
            &none             &none               &none           &none           &none                           &bt_0     &bt_1     &out OUT_USB     &none     &none     &none                  &none      &none      &none      &none      &to FACTORY_TEST
            >;
        };

        factory_test_layer {
            bindings = <
            &kp N0   &kp N6   &kp N2   &kp N8   &kp N4                                                                              &kp N4   &kp N8   &kp N2   &kp N6   &kp N0
            &kp N1   &kp N7   &kp N3   &kp N9   &kp N5   &kp N0                                                            &kp N0   &kp N5   &kp N9   &kp N3   &kp N7   &kp N1
            &kp N2   &kp N8   &kp N4   &kp N0   &kp N6   &kp N1                                                            &kp N1   &kp N6   &kp N0   &kp N4   &kp N8   &kp N2
            &kp N3   &kp N9   &kp N5   &kp N1   &kp N7   &kp N2                                                            &kp N2   &kp N7   &kp N1   &kp N5   &kp N9   &kp N3
            &kp N4   &kp N0   &kp N6   &kp N2   &kp N8   &kp N3   &kp N4   &kp N5   &kp N6      &kp N6   &kp N5   &kp N4   &kp N3   &kp N8   &kp N2   &kp N6   &kp N0   &kp N4
            &kp N5   &kp N1   &kp N7   &kp N3   &kp N9            &kp N7   &kp N8   &kp N9      &kp N9   &kp N8   &kp N7            &kp N9   &kp N3   &kp N7   &kp N1   &kp N5
            >;
        };
    };
};
